# Salin menjadi .env.docker.staging dan .env.docker.production.
# Beri production nama project, URL, port, database, key, dan password sendiri.
COMPOSE_PROJECT_NAME=laparin-staging
LAPARIN_IMAGE=your-dockerhub-user/laparin
LAPARIN_TAG=latest
LAPARIN_BIND_IP=127.0.0.1
LAPARIN_PORT=8101
LAPARIN_APP_ENV=staging
LAPARIN_APP_URL=http://localhost:8101
LAPARIN_APP_KEY=
LAPARIN_DB_NAME=laparin_staging
LAPARIN_DB_USER=laparin
LAPARIN_DB_PASSWORD=
LAPARIN_DB_ROOT_PASSWORD=
LAPARIN_SEED_CATALOG=false
